# ============================================================
#  .gitignore —— 针对 06_深度学习/ 目录
#
#  放在 ~/projects/06_深度学习/.gitignore
#  Git 仓库根目录就是这个文件夹
#
#  效果：126 MB  ->  约 1.9 MB
# ============================================================


# ============================================================
# 一、教材（别人的东西，60 MB，人人能下载）
# ============================================================
# d2l 官方教材，随时可以重新下载：
#   https://zh-v2.d2l.ai/d2l-zh-2.0.0.zip
#
# 不传的理由：
#   ① 不是你写的，是李沐团队的
#   ② 60 MB，占仓库 95% 的体积
#   ③ 师兄要看的是【你的代码】，不是教材
_教材/


# ============================================================
# 二、数据集（64 MB，跑代码时会自动下回来）
# ============================================================
# MNIST 等标准数据集，torchvision 会自动下载
data/MNIST/
**/MNIST/
*.gz

# 但保留你自己造的小数据
!**/student.csv
!**/示例数据.csv


# ============================================================
# 三、训练产物
# ============================================================
# 模型权重：能重新训练出来，而且通常很大
*.pth
*.pt
*.ckpt
*.onnx
*.h5
*.pb


# ============================================================
# 四、Python 运行产物
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so

# 虚拟环境（万一以后在这里建）
venv/
.venv/
env/
.venv-trash-*/

# 构建产物
build/
dist/
*.egg-info/


# ============================================================
# 五、工具缓存
# ============================================================
# Ruff 的缓存（虽然已经关了，但目录还在）
.ruff_cache/
.mypy_cache/
.pytest_cache/

# Jupyter 检查点
.ipynb_checkpoints/
*/.ipynb_checkpoints/*


# ============================================================
# 六、编辑器 / 系统
# ============================================================
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

Thumbs.db
desktop.ini
__MACOSX/
.DS_Store


# ============================================================
# 七、备份文件（我调试时留下的，不用传）
# ============================================================
*.bak
*.bak-*
*.tmp
*.log
~$*


# ============================================================
# 八、检查：初始化后应该看到这些
# ============================================================
#
#  git add . && git status 之后，应该看到：
#
#      .gitignore
#      .vscode/settings.json
#      教材导航.md
#      周报-10月第一周.md
#      第一个神经网络.py
#      练习/README.md
#      练习/草稿纸.py
#      练习/_杂项/验证测试.ipynb
#      练习/第02章_预备知识/01_张量操作.py
#      练习/第02章_预备知识/02_数据预处理.py
#      练习/第02章_预备知识/03_线性代数.py
#      练习/第02章_预备知识/04_微积分.py
#      练习/第02章_预备知识/data/student.csv
#
#  以及练习下那些空的章节目录（第03章、第04章...）
#
#  不应该看到：
#      _教材/ 下面的任何东西
#      data/MNIST/ 下面的任何东西
#      mnist_model.pth
#      .ruff_cache/
#      任何 .bak 文件

# ============================================================
# 九、数据集目录（Fashion-MNIST 等，约 82 MB）
# ============================================================
# 只忽略【仓库根目录】的 data/，
# 不影响 练习/第02章_预备知识/data/student.csv
/data/


# ============================================================
# 十、日报（个人过程记录，不进仓库）
# ============================================================
日报*.md
